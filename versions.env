# Pinned versions for DSv4 Ascend serving reproduction.
# Source before running scripts: source versions.env

export VLLM_ASCEND_IMAGE="${VLLM_ASCEND_IMAGE:-quay.io/ascend/vllm-ascend:v0.20.2rc1-a3}"
export LMCACHE_COMMIT="${LMCACHE_COMMIT:-a7934b79}"
export LMCACHE_ASCEND_COMMIT="${LMCACHE_ASCEND_COMMIT:-7c0fb92}"
export KVCACHE_OPS_COMMIT="${KVCACHE_OPS_COMMIT:-bab00e09}"

export MODEL_PATH="${MODEL_PATH:-/workspace/models/DeepSeek-V4-Flash-w8a8-mtp}"
export MODEL_NAME="${MODEL_NAME:-dsv4}"

# Container mount defaults (override on host)
export REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
export CONTAINER_REPO_MOUNT="${CONTAINER_REPO_MOUNT:-/workspace/dsv4-serving}"
export CONTAINER_LMCACHE_MOUNT="${CONTAINER_LMCACHE_MOUNT:-/workspace/LMCache}"
export CONTAINER_LMCACHE_ASCEND_MOUNT="${CONTAINER_LMCACHE_ASCEND_MOUNT:-/workspace/LMCache-Ascend}"
export CONTAINER_MODEL_MOUNT="${CONTAINER_MODEL_MOUNT:-/workspace/models}"
